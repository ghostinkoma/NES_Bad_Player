; =============================================================================
; mailbox.inc - 外部（エミュレータ Lua / 将来は RP2354）と 6502 の受け渡し領域
;
; CPU RAM の $0300-$03FF をメールボックスとして使う。
; 仕様は docs/BUILD.md「メールボックス仕様」と tools/emu_bridge/bridge.lua に一致させること。
;
;   外部 → 6502 : 「PPU のこのアドレスに、このデータを書いて」という転送要求
;   6502 → 外部 : パッド状態・フレームカウンタ
; =============================================================================

MB_FLAG    = $0300   ; 0=空き / 1=転送要求あり（外部が最後に1を書く。6502が処理後0に戻す）
MB_ADDR_HI = $0301   ; 転送先 PPU アドレス上位
MB_ADDR_LO = $0302   ; 転送先 PPU アドレス下位
MB_COUNT8  = $0303   ; 転送バイト数 / 8（1〜16 → 8〜128バイト）

MB_PAD     = $0320   ; 6502 が毎フレーム書く: パッド1の状態（nes.inc の PAD_*）
MB_FRAME   = $0321   ; 6502 が毎フレーム書く: フレームカウンタ（0-255 で一周）
MB_READY   = $0323   ; 6502 が初期化完了時に $A5 を書く
MB_ATTACH  = $0324   ; 外部が接続時に $5A を書く（リセットで0に戻る→外部が再送を判断）

MB_BUF     = $0380   ; 転送データ 128 バイト ($0380-$03FF)

MB_READY_MAGIC = $A5
MB_MAX_COUNT8  = 16

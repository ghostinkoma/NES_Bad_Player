; =============================================================================
; nes.inc - ファミコン ハードウェアレジスタ定義
; =============================================================================

; --- PPU ---------------------------------------------------------------------
PPUCTRL   = $2000   ; NMI許可 / パターンテーブル選択 / VRAMアドレス増分
PPUMASK   = $2001   ; BG・スプライト表示ON/OFF
PPUSTATUS = $2002   ; bit7 = VBlank中。読むと $2005/$2006 の書き込み順がリセット
OAMADDR   = $2003
OAMDATA   = $2004
PPUSCROLL = $2005
PPUADDR   = $2006   ; VRAMアドレス（上位→下位の順に2回書く）
PPUDATA   = $2007   ; VRAMデータ

; --- APU / I/O ---------------------------------------------------------------
APU_DMC   = $4010
OAMDMA    = $4014
JOY1      = $4016   ; パッド1（書き込み: ストローブ）
JOY2_FRAME= $4017   ; パッド2 / APUフレームカウンタ

; --- PPUCTRL ビット ----------------------------------------------------------
CTRL_NMI      = %10000000
CTRL_BG_1000  = %00010000   ; BG のパターンテーブルを $1000 にする
CTRL_INC32    = %00000100   ; $2007 書き込みで +32（縦方向）

; --- PPUMASK ビット ----------------------------------------------------------
MASK_BG       = %00001000   ; BG 表示
MASK_BG_LEFT  = %00000010   ; 左端8ドットにも BG を表示
MASK_SPR      = %00010000
MASK_SPR_LEFT = %00000100

; --- パッドのビット（readpad 後の pad 変数） ---------------------------------
PAD_A      = %10000000
PAD_B      = %01000000
PAD_SELECT = %00100000
PAD_START  = %00010000
PAD_UP     = %00001000
PAD_DOWN   = %00000100
PAD_LEFT   = %00000010
PAD_RIGHT  = %00000001
